# Адрес сайта (с https, без слеша в конце)
PUBLIC_URL=https://mhc.example.com
PORT=3000

# Секрет для подписи сессий: случайная строка от 32 символов, например вывод `openssl rand -hex 32`.
# Заготовку ниже сервер не примет (её все знают): тогда он сам создаст ключ в data/.secret.
SESSION_SECRET=замените-на-длинную-случайную-строку

# Discord-приложение (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Должен совпадать с Redirect в настройках OAuth2 приложения
DISCORD_REDIRECT_URI=https://mhc.example.com/auth/callback

# Бот (вкладка Bot) и ID вашего Discord-сервера
DISCORD_BOT_TOKEN=
GUILD_ID=

# Необязательно: ID ролей через запятую. Без них права берутся по названию ролей из настроек панели
ADMIN_ROLE_IDS=
MOD_ROLE_IDS=

# true — показывать кнопки демо-входа (только для теста, на боевом сайте выключите)
DEMO_LOGIN=false

# LifeX — привязка профиля игровой соцсети в кабинете гостя (фото, имя персонажа, телефон).
# Приложение создаётся на https://lifex.ls-project.com/dev, адреса токена и профиля — из документации /dev/docs.
# LifeX: привязка профиля игровой соцсети в кабинете гостя. Интеграция становится доступной, как только заданы адреса
# приложения ниже (CLIENT_ID, REDIRECT_URI, TOKEN_URL, PROFILE_URL). Включать/выключать её для гостей можно в панели:
# Настройки → «Интеграция LifeX» (по умолчанию включена, когда адреса заданы). Переключение не удаляет данные гостей.
# LIFEX_ENABLED оставлен как жёсткий стоп у хостинга: значение false отключает интеграцию независимо от настроек панели.
# Пусто/не задано — тумблер в панели работает как обычно.
LIFEX_ENABLED=
LIFEX_CLIENT_ID=
LIFEX_CLIENT_SECRET=
LIFEX_REDIRECT_URI=https://mhc.example.com/auth/lifex/callback
LIFEX_TOKEN_URL=
LIFEX_PROFILE_URL=
LIFEX_SCOPE=profile
